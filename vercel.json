{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/data/:name", "destination": "/api/data?name=:name" }
  ],
  "functions": {
    "api/*.py": {
      "includeFiles": "{server.py,ai.py,data/**}"
    }
  }
}
